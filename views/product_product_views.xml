<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hereda de low_stocks_product_alert para extender funcionalidad a 
         variantes. El campo alert_tag ya existe y se hereda del módulo base
         Este módulo solo asegura que funcione correctamente para variantes 
         individuales -->
    
    <!-- Vista tree para product.product - mostrar alert_tag heredado -->
    <record id="view_product_product_tree_inherit_variant_alert" 
            model="ir.ui.view">
        <field name="name">product.product.tree.variant.alert</field>
        <field name="model">product.product</field>
        <field name="inherit_id" 
               ref="low_stocks_product_alert.product_product_tree_view"/>
        <field name="arch" type="xml">
            <!-- El alert_tag ya está definido en el módulo base
                 Solo nos aseguramos que sea visible en variantes -->
            <xpath expr="//field[@name='alert_tag']" position="attributes">
                <attribute name="column_invisible">False</attribute>
            </xpath>
        </field>
    </record>

</odoo>
